---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	read_current_12h(read_current_12h)
	read_selected_interval(read_selected_interval)
	render_trend(render_trend)
	__end__([<p>__end__</p>]):::last
	__start__ --> read_current_12h;
	read_current_12h --> read_selected_interval;
	read_selected_interval --> render_trend;
	render_trend --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
