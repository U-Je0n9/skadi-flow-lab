---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	classify(classify)
	scope(scope)
	resolve(resolve)
	validate(validate)
	S1(S1)
	S2(S2)
	S3(S3)
	S4(S4)
	S5(S5)
	__end__([<p>__end__</p>]):::last
	S1 --> validate;
	S2 --> validate;
	S3 --> validate;
	S4 --> validate;
	S5 --> validate;
	__start__ --> classify;
	classify --> scope;
	resolve -.-> S1;
	resolve -.-> S2;
	resolve -.-> S3;
	resolve -.-> S4;
	resolve -.-> S5;
	resolve -.-> validate;
	scope -.-> resolve;
	scope -.-> validate;
	validate --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
